#!/usr/bin/env bash
# claude-conductor — CLI for managing parallel Claude Code sessions
# Usage: claude-conductor <command> [args]
#
# Commands:
#   status              Show all active sessions (default if no command given)
#   start               Register a new session interactively
#   update <#> <status> Update a session's status
#   done <#>            Mark a session complete
#   merge <#>           Mark a session as merged
#   abandon <#>         Mark a session as abandoned
#   clear               Archive completed sessions
#   help                Show this help message

set -euo pipefail

SESSIONS_FILE="SESSIONS.md"

bold()  { printf '\033[1m%s\033[0m' "$*"; }
green() { printf '\033[32m%s\033[0m' "$*"; }
yellow(){ printf '\033[33m%s\033[0m' "$*"; }
red()   { printf '\033[31m%s\033[0m' "$*"; }
dim()   { printf '\033[2m%s\033[0m' "$*"; }
cyan()  { printf '\033[36m%s\033[0m' "$*"; }

# Status icons
status_icon() {
  case "$1" in
    planning)  echo "📋" ;;
    coding)    echo "⚡" ;;
    reviewing) echo "🔍" ;;
    blocked)   echo "🚫" ;;
    done)      echo "✅" ;;
    merged)    echo "🏁" ;;
    abandoned) echo "❌" ;;
    *)         echo "❓" ;;
  esac
}

# Find SESSIONS.md by walking up from cwd to find a git root
find_sessions_file() {
  local dir="$PWD"
  while [[ "$dir" != "/" ]]; do
    if [[ -d "$dir/.git" ]]; then
      echo "$dir/$SESSIONS_FILE"
      return 0
    fi
    dir="$(dirname "$dir")"
  done
  # Fallback to cwd
  echo "$PWD/$SESSIONS_FILE"
}

# Check if SESSIONS.md exists
check_sessions() {
  local sf
  sf="$(find_sessions_file)"
  if [[ ! -f "$sf" ]]; then
    echo ""
    echo "$(yellow "!") No SESSIONS.md found."
    echo ""
    echo "  Create one with: $(dim "claude-conductor init")"
    echo "  Or use $(dim "/conductor start") in Claude Code to register sessions."
    echo ""
    exit 1
  fi
  echo "$sf"
}

# Validate status string
validate_status() {
  case "$1" in
    planning|coding|reviewing|blocked|done|merged|abandoned) return 0 ;;
    *) return 1 ;;
  esac
}

# Check if session number exists in Active Sessions table
session_exists() {
  local sf="$1" num="$2"
  sed -n '/^## Active Sessions/,/^## [^A]/p' "$sf" | \
    grep -qE "^\| *${num} *\|"
}

# Get a field value from a session row (field index: 2=#, 3=Persona, 4=Task, 5=Files, 6=Status, 7=Started, 8=Depends On, 9=Notes)
get_session_field() {
  local sf="$1" num="$2" field="$3"
  sed -n '/^## Active Sessions/,/^## [^A]/p' "$sf" | \
    grep -E "^\| *${num} *\|" | \
    awk -F'|' -v f="$field" '{gsub(/^ +| +$/, "", $f); print $f}'
}

# Get next available session number
next_session_number() {
  local sf="$1"
  local max=0
  local num
  while IFS= read -r line; do
    if [[ "$line" == "|"* && "$line" != *"---"* && "$line" != *"Persona"* ]]; then
      num=$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/, "", $2); print $2}')
      if [[ "$num" =~ ^[0-9]+$ ]] && (( num > max )); then
        max=$num
      fi
    fi
  done < <(sed -n '/^## Active Sessions/,/^## [^A]/p' "$sf")
  echo $((max + 1))
}

# Update a field in a session row in-place
update_session_field() {
  local sf="$1" num="$2" field_idx="$3" new_value="$4"
  local tmp="${sf}.tmp"
  awk -F'|' -v OFS='|' -v num="$num" -v fidx="$field_idx" -v val="$new_value" '
    /^## Active Sessions/ { in_active=1 }
    /^## [^A]/ && in_active { in_active=0 }
    in_active && /^\|/ && $2 ~ "^ *"num" *$" {
      $fidx = " " val " "
    }
    { print }
  ' "$sf" > "$tmp" && mv "$tmp" "$sf"
}

# Insert a new row into the Active Sessions table
insert_active_row() {
  local sf="$1" row="$2"
  local tmp="${sf}.tmp"
  awk -v row="$row" '
    /^## Active Sessions/ { in_active=1 }
    in_active && /^\|---/ { found_sep=1 }
    in_active && found_sep && !/^\|/ && !inserted {
      print row
      inserted=1
    }
    /^## [^A]/ && in_active { in_active=0 }
    { print }
  ' "$sf" > "$tmp" && mv "$tmp" "$sf"
}

# Insert a row into the Completed Sessions table
insert_completed_row() {
  local sf="$1" row="$2"
  local tmp="${sf}.tmp"
  awk -v row="$row" '
    /^## Completed Sessions/ { in_completed=1 }
    in_completed && /^\|---/ { found_sep=1 }
    in_completed && found_sep && !/^\|/ && !inserted {
      print row
      inserted=1
    }
    /^## [^C]/ && in_completed { in_completed=0 }
    { print }
  ' "$sf" > "$tmp" && mv "$tmp" "$sf"
}

# Append timestamped entry to Session Log
append_log() {
  local sf="$1" message="$2"
  local ts
  ts=$(date "+%Y-%m-%d %H:%M")
  printf '\n### [%s] %s\n' "$ts" "$message" >> "$sf"
}

# Check if any sessions depend on the given session number and print notifications
check_dependents() {
  local sf="$1" num="$2" new_status="$3"
  local lines
  lines=$(sed -n '/^## Active Sessions/,/^## [^A]/p' "$sf" | \
    grep -v '^|[-]' | grep -v 'Persona' | grep '^|')
  if [[ -z "$lines" ]]; then return 0; fi
  echo "$lines" | while IFS= read -r line; do
    local dep dep_num dep_persona
    dep=$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/, "", $8); print $8}')
    if echo "$dep" | grep -qE "(^|[^0-9])#?${num}([^0-9]|$)"; then
      dep_num=$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/, "", $2); print $2}')
      dep_persona=$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/, "", $3); print $3}')
      if [[ "$new_status" == "done" || "$new_status" == "merged" ]]; then
        echo "  $(green "→") Session #${dep_num} (${dep_persona}) is unblocked."
      elif [[ "$new_status" == "abandoned" ]]; then
        echo "  $(yellow "!") Session #${dep_num} (${dep_persona}) depends on #${num} which was abandoned."
      fi
    fi
  done
}

# Check if two paths overlap (exact match or prefix/parent relationship)
paths_overlap() {
  local a="$1" b="$2"
  # Normalize: strip trailing slashes
  a="${a%/}"
  b="${b%/}"
  # Exact match
  [[ "$a" == "$b" ]] && return 0
  # a is parent of b
  [[ "$b" == "$a/"* ]] && return 0
  # b is parent of a
  [[ "$a" == "$b/"* ]] && return 0
  return 1
}

# Detect file scope conflicts between active sessions
# Outputs pipe-delimited lines: num_a|persona_a|num_b|persona_b|overlapping_path
detect_conflicts() {
  local sf="$1"
  local -a nums=() personas=() files_list=()

  # Parse active sessions (only active statuses)
  while IFS= read -r line; do
    if [[ "$line" == "|"* && "$line" != *"---"* && "$line" != *"Persona"* ]]; then
      local num persona status files_raw
      num=$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/, "", $2); print $2}')
      persona=$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/, "", $3); print $3}')
      status=$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/, "", $6); print $6}')
      files_raw=$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/, "", $5); print $5}')

      case "$status" in
        planning|coding|reviewing|blocked)
          if [[ -n "$num" && "$num" =~ ^[0-9]+$ ]]; then
            nums+=("$num")
            personas+=("$persona")
            files_list+=("$files_raw")
          fi
          ;;
      esac
    fi
  done < <(sed -n '/^## Active Sessions/,/^## [^A]/p' "$sf")

  local count=${#nums[@]}
  if (( count < 2 )); then
    return 0
  fi

  # Compare every unique pair
  local i j
  for (( i=0; i<count; i++ )); do
    for (( j=i+1; j<count; j++ )); do
      local -a files_a=() files_b=()
      IFS=', ' read -ra files_a <<< "${files_list[$i]}"
      IFS=', ' read -ra files_b <<< "${files_list[$j]}"

      local fa fb
      for fa in "${files_a[@]}"; do
        [[ -z "$fa" ]] && continue
        for fb in "${files_b[@]}"; do
          [[ -z "$fb" ]] && continue
          if paths_overlap "$fa" "$fb"; then
            echo "${nums[$i]}|${personas[$i]}|${nums[$j]}|${personas[$j]}|$fa"
          fi
        done
      done
    done
  done
}

# Current timestamp
now_timestamp() { date "+%Y-%m-%d %H:%M"; }

# Convert timestamp to epoch seconds (macOS/Linux compatible)
timestamp_to_epoch() {
  local ts="$1"
  if date -j -f "%Y-%m-%d %H:%M" "$ts" "+%s" 2>/dev/null; then
    return 0
  fi
  date -d "$ts" "+%s" 2>/dev/null
}

# Format duration from seconds
format_duration() {
  local secs="$1"
  if (( secs < 0 )); then secs=0; fi
  local days=$((secs / 86400))
  local hours=$(( (secs % 86400) / 3600 ))
  local mins=$(( (secs % 3600) / 60 ))
  if (( days > 0 )); then
    echo "${days}d ${hours}h"
  elif (( hours > 0 )); then
    echo "${hours}h ${mins}m"
  else
    echo "${mins}m"
  fi
}

# Show status
cmd_status() {
  local sf
  sf="$(check_sessions)"

  echo ""
  echo "$(bold "Session Conductor")"
  echo "────────────────────────────────────"
  echo ""

  # Parse active sessions from the table
  local in_active=0
  local count=0
  while IFS= read -r line; do
    # Detect the Active Sessions table
    if [[ "$line" == *"## Active Sessions"* ]]; then
      in_active=1
      continue
    fi
    # Stop at the next section
    if [[ $in_active -eq 1 && "$line" == "## "* && "$line" != *"Active Sessions"* ]]; then
      break
    fi
    # Skip header rows
    if [[ $in_active -eq 1 && "$line" == "|"* && "$line" != *"---"* && "$line" != *"Persona"* ]]; then
      # Parse table row: | # | Persona | Task | Files | Status | Started | Depends On | Notes |
      local num persona task status depends
      num=$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/, "", $2); print $2}')
      persona=$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/, "", $3); print $3}')
      task=$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/, "", $4); print $4}')
      status=$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/, "", $6); print $6}')
      depends=$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/, "", $8); print $8}')

      if [[ -n "$num" && "$num" != " " ]]; then
        local icon
        icon=$(status_icon "$status")
        printf "  #%-2s %s %-10s — %-40s [%s]" "$num" "$icon" "$persona" "$task" "$status"
        if [[ -n "$depends" && "$depends" != "—" && "$depends" != "-" ]]; then
          printf " → waiting on %s" "$depends"
        fi
        echo ""
        count=$((count + 1))
      fi
    fi
  done < "$sf"

  if [[ $count -eq 0 ]]; then
    echo "  $(dim "No active sessions.")"
    echo ""
    echo "  Start sessions with: $(dim "/conductor start") or $(dim "/conductor plan")"
  fi

  echo ""

  # Show merge order section
  local in_merge=0
  while IFS= read -r line; do
    if [[ "$line" == *"## Merge Order"* ]]; then
      in_merge=1
      echo "$(bold "Merge Order:")"
      continue
    fi
    if [[ $in_merge -eq 1 && "$line" == "## "* ]]; then
      break
    fi
    if [[ $in_merge -eq 1 && -n "$line" ]]; then
      echo "  $line"
    fi
  done < "$sf"

  # Show file overlap warnings
  local conflicts
  conflicts=$(detect_conflicts "$sf")
  if [[ -n "$conflicts" ]]; then
    echo ""
    echo "$(bold "File Overlap Warnings")"
    echo ""
    while IFS='|' read -r num_a persona_a num_b persona_b path; do
      echo "  $(yellow "⚠") Sessions #${num_a} (${persona_a}) and #${num_b} (${persona_b}) both touch ${path}"
    done <<< "$conflicts"
  fi

  echo ""
}

# Initialize SESSIONS.md
cmd_init() {
  local sf
  sf="$(find_sessions_file)"

  if [[ -f "$sf" ]]; then
    echo "$(yellow "!") SESSIONS.md already exists at $(dim "$sf")"
    echo "  Use $(dim "/conductor start") to add sessions."
    exit 0
  fi

  # Try to get project name from git remote or directory name
  local project_name
  project_name=$(basename "$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")")

  printf "Project name [%s]: " "$project_name"
  read -r input_name
  project_name="${input_name:-$project_name}"

  cat > "$sf" << EOF
# ${project_name} — Session Conductor

Active coordination view for parallel Claude Code sessions.
Auto-maintained via [claude-conductor](https://github.com/code-katz/claude-conductor).

---

## Plan

No plan defined. Run \`/parallel\` to generate a plan, or \`claude-conductor add\` to register sessions.

## Active Sessions

| # | Persona | Task | Files | Status | Started | Depends On | Notes | Activity |
|---|---------|------|-------|--------|---------|------------|-------|----------|

## Merge Order

No dependencies defined.

## Completed Sessions

| # | Persona | Task | Files | Duration | Completed | Outcome |
|---|---------|------|-------|----------|-----------|---------|

## Session Log
EOF

  echo ""
  echo "$(green "✓") Created SESSIONS.md for $(bold "$project_name")"
  echo "  $(dim "$sf")"
  echo ""
  echo "  Next: use $(dim "/conductor start") in Claude Code to register sessions."
  echo ""
}

# Register new sessions interactively
cmd_start() {
  local sf
  sf="$(check_sessions)"
  local count="${1:-1}"

  if ! [[ "$count" =~ ^[0-9]+$ ]] || (( count < 1 )); then
    echo "$(red "Error:") count must be a positive integer."
    exit 1
  fi

  echo ""
  echo "$(bold "Register Sessions")"
  echo "────────────────────────────────────"

  local i
  for (( i=1; i<=count; i++ )); do
    local num
    num=$(next_session_number "$sf")

    if (( count > 1 )); then
      echo ""
      echo "$(bold "Session $i of $count") (will be #${num})"
    else
      echo ""
      echo "Registering session #${num}:"
    fi

    local persona task files depends notes
    printf "  Persona: "
    read -r persona
    printf "  Task: "
    read -r task
    printf "  Files: "
    read -r files
    printf "  Depends on (e.g. #1, or blank): "
    read -r depends
    depends="${depends:-}"

    local ts
    ts=$(now_timestamp)
    local row="| ${num} | ${persona} | ${task} | ${files} | planning | ${ts} | ${depends} | | |"
    insert_active_row "$sf" "$row"
    append_log "$sf" "Session #${num} registered: ${persona} — ${task}"

    echo "  $(green "✓") Session #${num} registered ($(status_icon planning) planning)"
  done

  maybe_regenerate_dashboard "$sf"
  echo ""
}

# Append a checklist item to the Plan section
append_plan_item() {
  local sf="$1" num="$2" persona="$3" task="$4" files="$5"
  local item="- [ ] #${num} ${persona}: ${task} (${files})"
  local tmp="${sf}.tmp"
  local inserted=0
  local in_plan=0
  while IFS= read -r line; do
    if [[ "$line" == "## Plan" ]]; then
      in_plan=1
      echo "$line"
      continue
    fi
    if [[ $in_plan -eq 1 && "$line" == "## "* ]]; then
      # Insert before next section
      if [[ $inserted -eq 0 ]]; then
        echo "$item"
        echo ""
        inserted=1
      fi
      in_plan=0
      echo "$line"
      continue
    fi
    # Replace placeholder text if present
    if [[ $in_plan -eq 1 && "$line" == "No plan defined."* ]]; then
      echo "$item"
      inserted=1
      continue
    fi
    # Insert after last checklist item
    if [[ $in_plan -eq 1 && "$line" == "- ["* ]]; then
      echo "$line"
      continue
    fi
    if [[ $in_plan -eq 1 && "$line" != "- ["* && "$line" != "" && $inserted -eq 0 ]]; then
      echo "$item"
      inserted=1
      echo "$line"
      continue
    fi
    echo "$line"
  done < "$sf" > "$tmp"
  if [[ $inserted -eq 0 ]]; then
    echo "$item" >> "$tmp"
  fi
  mv "$tmp" "$sf"
}

# Toggle a plan checklist item from [ ] to [x] by session number
toggle_plan_item() {
  local sf="$1" num="$2"
  local tmp="${sf}.tmp"
  sed "s/^- \[ \] #${num} /- [x] #${num} /" "$sf" > "$tmp" && mv "$tmp" "$sf"
}

# Register a session non-interactively (for /parallel integration)
cmd_add() {
  local sf
  sf="$(check_sessions)"

  local persona="" task="" files="" depends=""

  # Parse named flags
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --persona) persona="$2"; shift 2 ;;
      --task)    task="$2"; shift 2 ;;
      --files)   files="$2"; shift 2 ;;
      --depends) depends="$2"; shift 2 ;;
      *) shift ;;
    esac
  done

  if [[ -z "$persona" ]]; then
    echo "$(red "Error:") --persona is required."
    echo "  Usage: claude-conductor add --persona <name> --task <desc> --files <paths> [--depends <#>]"
    exit 1
  fi

  if [[ -z "$task" ]]; then
    echo "$(red "Error:") --task is required."
    echo "  Usage: claude-conductor add --persona <name> --task <desc> --files <paths> [--depends <#>]"
    exit 1
  fi

  local num
  num=$(next_session_number "$sf")
  local ts
  ts=$(now_timestamp)
  local row="| ${num} | ${persona} | ${task} | ${files} | planning | ${ts} | ${depends} | | |"
  insert_active_row "$sf" "$row"
  append_plan_item "$sf" "$num" "$persona" "$task" "$files"
  append_log "$sf" "Session #${num} registered: ${persona} — ${task}"

  maybe_regenerate_dashboard "$sf"

  echo ""
  echo "$(green "✓") Session #${num} registered: $(bold "$persona") — ${task}"
  echo "  Files: ${files}"
  if [[ -n "$depends" ]]; then
    echo "  Depends on: ${depends}"
  fi
  echo ""
}

# Update a session's status
cmd_update() {
  local sf
  sf="$(check_sessions)"

  local num="${1:-}"
  local new_status="${2:-}"

  if [[ -z "$num" || -z "$new_status" ]]; then
    echo "$(red "Usage:") claude-conductor update <#> <status> [--activity <text>]"
    echo "  Valid statuses: planning, coding, reviewing, blocked, done, merged, abandoned"
    exit 1
  fi

  # Parse optional --activity flag
  shift 2
  local activity=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --activity) activity="$2"; shift 2 ;;
      *) shift ;;
    esac
  done

  if ! session_exists "$sf" "$num"; then
    echo "$(red "Error:") Session #${num} not found in Active Sessions."
    exit 1
  fi

  if ! validate_status "$new_status"; then
    echo "$(red "Error:") Invalid status '${new_status}'."
    echo "  Valid statuses: planning, coding, reviewing, blocked, done, merged, abandoned"
    exit 1
  fi

  if [[ -n "$activity" ]]; then
    # Update both status and activity in one pass to avoid race conditions
    local tmp="${sf}.tmp"
    awk -F'|' -v OFS='|' -v num="$num" -v status="$new_status" -v act="$activity" '
      /^## Active Sessions/ { in_active=1 }
      /^## [^A]/ && in_active { in_active=0 }
      in_active && /^\|/ && $2 ~ "^ *"num" *$" {
        $6 = " " status " "
        $10 = " " act " "
      }
      { print }
    ' "$sf" > "$tmp" && mv "$tmp" "$sf"
  else
    update_session_field "$sf" "$num" 6 "$new_status"
  fi
  append_log "$sf" "Session #${num} status changed to ${new_status}${activity:+ ($activity)}"

  echo ""
  echo "$(green "✓") Session #${num} updated to $(status_icon "$new_status") ${new_status}"
  if [[ -n "$activity" ]]; then
    echo "  Activity: ${activity}"
  fi
  check_dependents "$sf" "$num" "$new_status"
  maybe_regenerate_dashboard "$sf"
  echo ""
}

# Mark a session as done
cmd_done() {
  local sf
  sf="$(check_sessions)"

  local num="${1:-}"
  if [[ -z "$num" ]]; then
    echo "$(red "Usage:") claude-conductor done <#>"
    exit 1
  fi

  if ! session_exists "$sf" "$num"; then
    echo "$(red "Error:") Session #${num} not found in Active Sessions."
    exit 1
  fi

  update_session_field "$sf" "$num" 6 "done"
  update_session_field "$sf" "$num" 10 ""
  toggle_plan_item "$sf" "$num"
  append_log "$sf" "Session #${num} marked done"

  echo ""
  echo "$(green "✓") Session #${num} marked $(status_icon done) done"
  check_dependents "$sf" "$num" "done"
  maybe_regenerate_dashboard "$sf"
  echo ""
}

# Mark a session as merged
cmd_merge() {
  local sf
  sf="$(check_sessions)"

  local num="${1:-}"
  if [[ -z "$num" ]]; then
    echo "$(red "Usage:") claude-conductor merge <#>"
    exit 1
  fi

  if ! session_exists "$sf" "$num"; then
    echo "$(red "Error:") Session #${num} not found in Active Sessions."
    exit 1
  fi

  update_session_field "$sf" "$num" 6 "merged"
  update_session_field "$sf" "$num" 10 ""
  toggle_plan_item "$sf" "$num"
  append_log "$sf" "Session #${num} marked merged"

  echo ""
  echo "$(green "✓") Session #${num} marked $(status_icon merged) merged"
  maybe_regenerate_dashboard "$sf"
  echo ""
}

# Mark a session as abandoned
cmd_abandon() {
  local sf
  sf="$(check_sessions)"

  local num="${1:-}"
  if [[ -z "$num" ]]; then
    echo "$(red "Usage:") claude-conductor abandon <#> [reason]"
    exit 1
  fi

  if ! session_exists "$sf" "$num"; then
    echo "$(red "Error:") Session #${num} not found in Active Sessions."
    exit 1
  fi

  shift
  local reason="$*"

  update_session_field "$sf" "$num" 6 "abandoned"
  if [[ -n "$reason" ]]; then
    update_session_field "$sf" "$num" 10 "$reason"
  fi
  append_log "$sf" "Session #${num} abandoned${reason:+: $reason}"

  echo ""
  echo "$(green "✓") Session #${num} marked $(status_icon abandoned) abandoned${reason:+ — $reason}"
  check_dependents "$sf" "$num" "abandoned"
  maybe_regenerate_dashboard "$sf"
  echo ""
}

# Archive completed sessions and reset
cmd_clear() {
  local sf
  sf="$(check_sessions)"

  # Collect rows to archive (done, merged, or abandoned)
  local -a to_clear=()
  local -a to_keep=()

  while IFS= read -r line; do
    if [[ "$line" == "|"* && "$line" != *"---"* && "$line" != *"Persona"* ]]; then
      local row_status
      row_status=$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/, "", $6); print $6}')
      if [[ "$row_status" == "done" || "$row_status" == "merged" || "$row_status" == "abandoned" ]]; then
        to_clear+=("$line")
      else
        to_keep+=("$line")
      fi
    fi
  done < <(sed -n '/^## Active Sessions/,/^## [^A]/p' "$sf")

  if [[ ${#to_clear[@]} -eq 0 ]]; then
    echo ""
    echo "$(dim "No sessions to archive.")"
    echo ""
    exit 0
  fi

  local now_ts
  now_ts=$(now_timestamp)
  local now_epoch
  now_epoch=$(timestamp_to_epoch "$now_ts")

  # Build completed rows and insert them
  local cleared_count=0
  for row in "${to_clear[@]}"; do
    local c_num c_persona c_task c_files c_status c_started
    c_num=$(echo "$row" | awk -F'|' '{gsub(/^ +| +$/, "", $2); print $2}')
    c_persona=$(echo "$row" | awk -F'|' '{gsub(/^ +| +$/, "", $3); print $3}')
    c_task=$(echo "$row" | awk -F'|' '{gsub(/^ +| +$/, "", $4); print $4}')
    c_files=$(echo "$row" | awk -F'|' '{gsub(/^ +| +$/, "", $5); print $5}')
    c_status=$(echo "$row" | awk -F'|' '{gsub(/^ +| +$/, "", $6); print $6}')
    c_started=$(echo "$row" | awk -F'|' '{gsub(/^ +| +$/, "", $7); print $7}')

    # Calculate duration
    local duration="—"
    local start_epoch
    start_epoch=$(timestamp_to_epoch "$c_started" 2>/dev/null) || true
    if [[ -n "$start_epoch" && -n "$now_epoch" ]]; then
      local diff=$((now_epoch - start_epoch))
      duration=$(format_duration "$diff")
    fi

    local completed_row="| ${c_num} | ${c_persona} | ${c_task} | ${c_files} | ${duration} | ${now_ts} | ${c_status} |"
    insert_completed_row "$sf" "$completed_row"
    cleared_count=$((cleared_count + 1))
  done

  # Remove cleared rows from Active Sessions table
  # Build a temp file without the cleared rows
  local tmp="${sf}.tmp"
  local in_active=0
  while IFS= read -r line; do
    if [[ "$line" == *"## Active Sessions"* ]]; then
      in_active=1
      echo "$line"
      continue
    fi
    if [[ $in_active -eq 1 && "$line" == "## "* && "$line" != *"Active Sessions"* ]]; then
      in_active=0
      echo "$line"
      continue
    fi
    if [[ $in_active -eq 1 && "$line" == "|"* && "$line" != *"---"* && "$line" != *"Persona"* ]]; then
      local row_status
      row_status=$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/, "", $6); print $6}')
      if [[ "$row_status" == "done" || "$row_status" == "merged" || "$row_status" == "abandoned" ]]; then
        continue  # skip cleared rows
      fi
    fi
    echo "$line"
  done < "$sf" > "$tmp"
  mv "$tmp" "$sf"

  # Renumber remaining active sessions
  if [[ ${#to_keep[@]} -gt 0 ]]; then
    # Build old-to-new number mapping
    local -a old_nums=()
    local new_num=1
    for row in "${to_keep[@]}"; do
      local old_num
      old_num=$(echo "$row" | awk -F'|' '{gsub(/^ +| +$/, "", $2); print $2}')
      old_nums+=("$old_num")
    done

    # Apply renumbering with awk
    local tmp2="${sf}.tmp"
    local in_active2=0
    local row_idx=0
    while IFS= read -r line; do
      if [[ "$line" == *"## Active Sessions"* ]]; then
        in_active2=1
        echo "$line"
        continue
      fi
      if [[ $in_active2 -eq 1 && "$line" == "## "* && "$line" != *"Active Sessions"* ]]; then
        in_active2=0
        echo "$line"
        continue
      fi
      if [[ $in_active2 -eq 1 && "$line" == "|"* && "$line" != *"---"* && "$line" != *"Persona"* ]]; then
        new_num=$((row_idx + 1))
        # Replace session number (field 2)
        line=$(echo "$line" | awk -F'|' -v OFS='|' -v n="$new_num" '{$2 = " " n " "; print}')
        # Update Depends On references
        local k
        for (( k=0; k<${#old_nums[@]}; k++ )); do
          local old="${old_nums[$k]}"
          local new=$((k + 1))
          if [[ "$old" != "$new" ]]; then
            line=$(echo "$line" | sed "s/#${old}/#${new}/g")
          fi
        done
        row_idx=$((row_idx + 1))
      fi
      echo "$line"
    done < "$sf" > "$tmp2"
    mv "$tmp2" "$sf"
  fi

  append_log "$sf" "Archived ${cleared_count} session(s)"

  echo ""
  echo "$(green "✓") Archived ${cleared_count} session(s) to Completed Sessions."
  if [[ ${#to_keep[@]} -gt 0 ]]; then
    echo "  ${#to_keep[@]} session(s) remain active (renumbered)."
  fi
  maybe_regenerate_dashboard "$sf"
  echo ""
}

# Show file scope conflicts
cmd_conflicts() {
  local sf
  sf="$(check_sessions)"

  local conflicts
  conflicts=$(detect_conflicts "$sf")

  echo ""
  if [[ -z "$conflicts" ]]; then
    echo "$(green "✓") No file scope conflicts detected."
  else
    echo "$(bold "File Overlap Warnings")"
    echo ""
    while IFS='|' read -r num_a persona_a num_b persona_b path; do
      echo "  $(yellow "⚠") Sessions #${num_a} (${persona_a}) and #${num_b} (${persona_b}) both touch ${path}"
    done <<< "$conflicts"
  fi
  echo ""
}

# Find an available port starting from 8484, trying up to 10 ports
find_available_port() {
  local base=8484
  local max_tries=10
  for ((i=0; i<max_tries; i++)); do
    local p=$((base + i))
    if ! (echo >/dev/tcp/127.0.0.1/$p) 2>/dev/null; then
      echo "$p"
      return 0
    fi
  done
  return 1
}

# Live dashboard (Node.js) — delegates to dashboard/watcher.js
cmd_dashboard_live() {
  local script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  local repo_dir
  repo_dir="$(dirname "$script_dir")"
  local watcher="$repo_dir/dashboard/watcher.js"
  local sf
  sf="$(find_sessions_file)"
  local pidfile
  pidfile="$(dirname "$sf")/.conductor-live-server.pid"

  if ! command -v node >/dev/null 2>&1; then
    echo ""
    echo "$(red "Error:") Node.js is required for the live dashboard."
    echo "  Install Node.js 18+ or use the static dashboard: $(dim "claude-conductor dashboard --open")"
    echo ""
    return 1
  fi

  if [[ ! -f "$watcher" ]]; then
    echo ""
    echo "$(red "Error:") watcher.js not found at $watcher"
    echo "  Run $(dim "install.sh --with-dashboard") to set up the live dashboard."
    echo ""
    return 1
  fi

  # Handle --stop
  if [[ "${1:-}" == "--stop" ]]; then
    if [[ -f "$pidfile" ]]; then
      local pid
      pid=$(<"$pidfile")
      if kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null || true
        rm -f "$pidfile"
        echo ""
        echo "$(green "✓") Live dashboard stopped."
        echo ""
      else
        rm -f "$pidfile"
        echo ""
        echo "$(dim "Server already stopped (stale pidfile removed).")"
        echo ""
      fi
    else
      echo ""
      echo "$(dim "No live dashboard running.")"
      echo ""
    fi
    return
  fi

  # Check if already running
  if [[ -f "$pidfile" ]]; then
    local pid
    pid=$(<"$pidfile")
    if kill -0 "$pid" 2>/dev/null; then
      echo ""
      echo "  Live dashboard already running (PID $pid)."
      local url="http://localhost:3001"
      if command -v open >/dev/null 2>&1; then
        open "$url"
      elif command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$url"
      fi
      echo "  Opened: $(dim "$url")"
      echo "  Stop with: $(dim "claude-conductor dashboard --live --stop")"
      echo ""
      return
    else
      rm -f "$pidfile"
    fi
  fi

  # Start the Node.js watcher in background
  local project_dir
  project_dir="$(dirname "$sf")"
  cd "$project_dir"
  node "$watcher" >/dev/null 2>&1 &
  local node_pid=$!
  echo "$node_pid" > "$pidfile"
  sleep 1

  if ! kill -0 "$node_pid" 2>/dev/null; then
    rm -f "$pidfile"
    echo ""
    echo "$(red "Error:") Live dashboard failed to start. Run manually to see errors:"
    echo "  $(dim "cd $repo_dir/dashboard && node watcher.js")"
    echo ""
    return 1
  fi

  echo ""
  echo "$(green "✓") Live dashboard started (PID $node_pid)."
  local url="http://localhost:3001"
  if command -v open >/dev/null 2>&1; then
    open "$url"
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url"
  fi
  echo "  Opened: $(dim "$url")"
  echo "  Stop with: $(dim "claude-conductor dashboard --live --stop")"
  echo ""
}

# Link a JSONL session to a conductor session number
cmd_link() {
  local session_num="${1:-}"
  local session_id="${2:-}"

  if [[ -z "$session_num" || -z "$session_id" ]]; then
    echo ""
    echo "$(red "Usage:") claude-conductor link <session#> <session_id>"
    echo "  Maps a Claude Code session UUID to a conductor session number."
    echo ""
    return 1
  fi

  local sf
  sf="$(find_sessions_file)"
  local links_file="$(dirname "$sf")/.conductor-links.json"

  local tmp_file
  tmp_file="$(mktemp)"
  if [[ -f "$links_file" ]]; then
    python3 -c "
import json, sys
try:
    data = json.load(open('$links_file'))
except: data = []
data = [e for e in data if e.get('conductorNumber') != $session_num]
data.append({'sessionId': '$session_id', 'conductorNumber': $session_num, 'persona': ''})
json.dump(data, open('$tmp_file', 'w'), indent=2)
" 2>/dev/null
  else
    echo "[{\"sessionId\": \"$session_id\", \"conductorNumber\": $session_num, \"persona\": \"\"}]" | python3 -m json.tool > "$tmp_file" 2>/dev/null
  fi
  mv "$tmp_file" "$links_file"

  echo ""
  echo "$(green "✓") Linked session #$session_num to $session_id"
  echo ""
}

# Unlink a conductor session
cmd_unlink() {
  local session_num="${1:-}"

  if [[ -z "$session_num" ]]; then
    echo ""
    echo "$(red "Usage:") claude-conductor unlink <session#>"
    echo ""
    return 1
  fi

  local sf
  sf="$(find_sessions_file)"
  local links_file="$(dirname "$sf")/.conductor-links.json"

  if [[ ! -f "$links_file" ]]; then
    echo ""
    echo "$(dim "No links file found.")"
    echo ""
    return
  fi

  local tmp_file
  tmp_file="$(mktemp)"
  python3 -c "
import json
data = json.load(open('$links_file'))
data = [e for e in data if e.get('conductorNumber') != $session_num]
json.dump(data, open('$tmp_file', 'w'), indent=2)
" 2>/dev/null
  mv "$tmp_file" "$links_file"

  echo ""
  echo "$(green "✓") Unlinked session #$session_num"
  echo ""
}

# Generate HTML dashboard (delegates to bin/generate-dashboard)
cmd_dashboard() {
  # Handle --live flag
  if [[ "${1:-}" == "--live" ]]; then
    shift
    cmd_dashboard_live "$@"
    return
  fi

  local sf
  sf="$(check_sessions)"

  local script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  local gen="$script_dir/generate-dashboard"

  if [[ ! -x "$gen" ]]; then
    echo "$(red "Error:") generate-dashboard not found at $gen"
    exit 1
  fi

  local dashboard_dir
  dashboard_dir="$(dirname "$sf")"
  local pidfile="$dashboard_dir/.conductor-server.pid"

  # Handle --stop
  if [[ "${1:-}" == "--stop" ]]; then
    if [[ -f "$pidfile" ]]; then
      local pid port
      read pid port < "$pidfile"
      if kill -0 "$pid" 2>/dev/null; then
        local proc_cmd
        proc_cmd=$(ps -p "$pid" -o args= 2>/dev/null || true)
        if [[ "$proc_cmd" == *"http.server"* ]]; then
          kill "$pid" 2>/dev/null || true
          echo ""
          echo "$(green "✓") Dashboard server stopped (port ${port})."
          echo ""
        else
          echo ""
          echo "$(red "Warning:") PID $pid is not an http.server process. Removing stale pidfile."
          echo ""
        fi
      else
        echo ""
        echo "$(dim "Server already stopped (stale pidfile removed).")"
        echo ""
      fi
      rm -f "$pidfile"
    else
      echo ""
      echo "$(dim "No dashboard server running.")"
      echo ""
    fi
    return
  fi

  local dashboard_path
  dashboard_path=$("$gen" "$sf")

  echo ""
  echo "$(green "✓") Dashboard generated: $(dim "$dashboard_path")"

  if [[ "${1:-}" == "--open" ]]; then
    local pid port

    # Check for existing server (and clean up stale pidfile)
    if [[ -f "$pidfile" ]]; then
      read pid port < "$pidfile"
      if kill -0 "$pid" 2>/dev/null; then
        echo "  Server already running on port ${port}."
        local url="http://localhost:${port}/.conductor-dashboard.html"
        if command -v open >/dev/null 2>&1; then
          open "$url"
        elif command -v xdg-open >/dev/null 2>&1; then
          xdg-open "$url"
        fi
        echo "  Opened: $(dim "$url")"
        echo "  Stop with: $(dim "claude-conductor dash --stop")"
        echo ""
        return
      else
        rm -f "$pidfile"
      fi
    fi

    # Start a new server on an available port
    port=$(find_available_port) || {
      echo "  $(red "Error:") No available port found (tried 8484-8493)."
      echo ""
      return 1
    }

    local serve_script="$script_dir/serve-dashboard"
    if [[ -x "$serve_script" ]]; then
      python3 "$serve_script" "$port" "$dashboard_dir" &
    else
      python3 -m http.server "$port" --directory "$dashboard_dir" --bind 127.0.0.1 >/dev/null 2>&1 &
    fi
    echo "$! $port" > "$pidfile"
    echo "  $(green "✓") Server started on port ${port} (PID $!)."
    sleep 0.5

    local url="http://localhost:${port}/.conductor-dashboard.html"
    if command -v open >/dev/null 2>&1; then
      open "$url"
    elif command -v xdg-open >/dev/null 2>&1; then
      xdg-open "$url"
    fi
    echo "  Opened: $(dim "$url")"
    echo "  Stop with: $(dim "claude-conductor dash --stop")"
  fi
  echo ""
}

# Regenerate dashboard if it already exists (opt-in guard)
maybe_regenerate_dashboard() {
  local sf="$1"
  local dashboard_dir
  dashboard_dir="$(dirname "$sf")"
  if [[ -f "$dashboard_dir/.conductor-dashboard.html" ]]; then
    local script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    "$script_dir/generate-dashboard" "$sf" >/dev/null 2>&1 || true
  fi
}

# Help
cmd_help() {
  echo ""
  echo "$(bold "claude-conductor") — Coordinate parallel Claude Code sessions"
  echo ""
  echo "$(bold "Usage:")"
  echo "  claude-conductor [command] [args]"
  echo ""
  echo "$(bold "Commands:")"
  echo "  status              Show all active sessions $(dim "(default)")"
  echo "  start [count]       Register new session(s) interactively"
  echo "  add --persona <name> --task <desc> --files <paths> [--depends <#>]"
  echo "                      Register a session non-interactively"
  echo "  update <#> <status> Update a session's status"
  echo "  done <#>            Mark a session complete"
  echo "  merge <#>           Mark a session as merged"
  echo "  abandon <#> [reason] Mark a session as abandoned"
  echo "  clear               Archive completed sessions"
  echo "  conflicts           Check for file scope overlaps between sessions"
  echo "  dashboard           Generate HTML dashboard (--open to view, --live for Node.js)"
  echo "  link <#> <id>       Link a Claude Code session to a conductor session"
  echo "  unlink <#>          Remove a session link"
  echo "  init                Create SESSIONS.md in the current project"
  echo "  help                Show this help message"
  echo ""
  echo "$(bold "Aliases:")"
  echo "  s                   status"
  echo "  u                   update"
  echo "  d                   done"
  echo "  m                   merge"
  echo "  dash                dashboard"
  echo ""
  echo "$(bold "Statuses:")"
  echo "  📋 planning    Session in plan mode"
  echo "  ⚡ coding      Actively writing code"
  echo "  🔍 reviewing   Code complete, reviewing"
  echo "  🚫 blocked     Waiting on dependency"
  echo "  ✅ done        Task complete, ready to merge"
  echo "  🏁 merged      Code merged"
  echo "  ❌ abandoned   Session stopped"
  echo ""
}

# Main dispatch (guarded for sourcing)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  cmd="${1:-status}"
  shift 2>/dev/null || true

  case "$cmd" in
    status|s)       cmd_status "$@" ;;
    init)           cmd_init "$@" ;;
    start)          cmd_start "$@" ;;
    add)            cmd_add "$@" ;;
    update|u)       cmd_update "$@" ;;
    done|d)         cmd_done "$@" ;;
    merge|m)        cmd_merge "$@" ;;
    abandon)        cmd_abandon "$@" ;;
    clear)          cmd_clear "$@" ;;
    conflicts)      cmd_conflicts "$@" ;;
    dashboard|dash) cmd_dashboard "$@" ;;
    link)           cmd_link "$@" ;;
    unlink)         cmd_unlink "$@" ;;
    help|--help|-h) cmd_help ;;
    *)
      echo "$(red "Unknown command:") $cmd"
      echo "Run $(dim "claude-conductor help") for usage."
      exit 1
      ;;
  esac
fi
