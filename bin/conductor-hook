#!/usr/bin/env bash
# conductor-hook — Claude Code PostToolUse hook (Edit|Write|NotebookEdit)
#
# Reads the hook JSON from stdin, resolves WHICH conductor session this
# Claude Code session is (via .conductor-links.json, then a git branch
# match against the Branch column), and promotes that session from
# planning to coding on its first edit. Never guesses: if the session
# cannot be resolved, it does nothing.
#
# Wiring (until the plugin ships hooks.json), in ~/.claude/settings.json:
#   {
#     "hooks": {
#       "PostToolUse": [
#         { "matcher": "Edit|Write|NotebookEdit",
#           "hooks": [ { "type": "command", "command": "conductor-hook" } ] }
#       ]
#     }
#   }
#
# Requires jq. Always exits 0: a hook failure must never block the session.

set -uo pipefail

command -v jq >/dev/null 2>&1 || exit 0
input=$(cat 2>/dev/null) || exit 0
[[ -n "$input" ]] || exit 0

session_id=$(printf '%s' "$input" | jq -r '.session_id // empty' 2>/dev/null)
cwd=$(printf '%s' "$input" | jq -r '.cwd // empty' 2>/dev/null)
[[ -n "$session_id" ]] || exit 0

# One-shot per Claude Code session
marker="${TMPDIR:-/tmp}/.conductor-hook-${session_id}"
[[ -f "$marker" ]] && exit 0

# Locate the project root, worktree-aware: SESSIONS.md lives in the MAIN
# checkout so all parallel sessions share one coordination file.
dir="${cwd:-${CLAUDE_PROJECT_DIR:-$PWD}}"
root=""
if command -v git >/dev/null 2>&1; then
  toplevel=$(cd "$dir" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null) || toplevel=""
  if [[ -n "$toplevel" ]]; then
    common=$(cd "$toplevel" && git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
      || common=$(cd "$toplevel" && git rev-parse --git-common-dir 2>/dev/null) || common=""
    case "$common" in
      */.git) root="${common%/.git}" ;;
      *)      root="$toplevel" ;;
    esac
  fi
fi
[[ -n "$root" && -f "$root/SESSIONS.md" ]] || exit 0
sf="$root/SESSIONS.md"

num=""

# 1. Preferred: explicit link file (sessionId -> conductor session number)
links="$root/.conductor-links.json"
if [[ -f "$links" ]]; then
  num=$(jq -r --arg sid "$session_id" \
    '.[] | select(.sessionId == $sid) | .conductorNumber' "$links" 2>/dev/null | head -1)
fi

# 2. Fallback: match this checkout's branch against the Branch column
if [[ -z "$num" ]]; then
  branch=$(cd "$dir" 2>/dev/null && git rev-parse --abbrev-ref HEAD 2>/dev/null) || branch=""
  if [[ -n "$branch" && "$branch" != "HEAD" ]]; then
    num=$(sed -n '/^## Active Sessions/,/^## [^A]/p' "$sf" | \
      awk -F'|' -v br="$branch" '{
        f = $11; gsub(/^ +| +$/, "", f)
        n = $2;  gsub(/^ +| +$/, "", n)
        if (f == br && n ~ /^[0-9]+$/) { print n; exit }
      }')
  fi
fi

[[ -n "$num" ]] || exit 0

# Only promote sessions still in planning
status=$(sed -n '/^## Active Sessions/,/^## [^A]/p' "$sf" | \
  grep -E "^\| *${num} *\|" | head -1 | \
  awk -F'|' '{gsub(/^ +| +$/, "", $6); print $6}')
[[ "$status" == "planning" ]] || { touch "$marker" 2>/dev/null || true; exit 0; }

touch "$marker" 2>/dev/null || true

# Prefer the sibling CLI (plugin/repo layout); fall back to PATH.
conductor="$(cd "$(dirname "$0")" && pwd)/claude-conductor"
[[ -x "$conductor" ]] || conductor="claude-conductor"
(cd "$dir" 2>/dev/null && "$conductor" u "$num" coding --activity "writing code" >/dev/null 2>&1) || true
exit 0
