#!/usr/bin/env bash
# generate-dashboard — Static HTML dashboard generator for claude-conductor
# Reads SESSIONS.md and writes a self-contained .conductor-dashboard.html
#
# Usage: generate-dashboard [path/to/SESSIONS.md]
#   If no path given, walks up from cwd to find git root + SESSIONS.md

set -euo pipefail

SESSIONS_FILE="SESSIONS.md"
DASHBOARD_FILE=".conductor-dashboard.html"

# --- Locate SESSIONS.md ---

find_sessions_file() {
  local dir="$PWD"
  while [[ "$dir" != "/" ]]; do
    if [[ -d "$dir/.git" ]]; then
      echo "$dir/$SESSIONS_FILE"
      return 0
    fi
    dir="$(dirname "$dir")"
  done
  echo "$PWD/$SESSIONS_FILE"
}

sf="${1:-}"
if [[ -z "$sf" ]]; then
  sf="$(find_sessions_file)"
fi

if [[ ! -f "$sf" ]]; then
  echo "Error: SESSIONS.md not found at $sf" >&2
  exit 1
fi

dashboard_dir="$(dirname "$sf")"
dashboard_file="$dashboard_dir/$DASHBOARD_FILE"

# --- Parse SESSIONS.md ---

# Project name from first heading
project_name=$(grep -m1 '^# ' "$sf" | sed 's/^# //' | sed 's/ — .*//')

# Parse Active Sessions table into arrays
active_count=0
declare -a a_num=() a_persona=() a_task=() a_files=() a_status=() a_started=() a_depends=() a_notes=() a_activity=()

while IFS= read -r line; do
  if [[ "$line" == "|"* && "$line" != *"---"* && "$line" != *"Persona"* ]]; then
    num=$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/, "", $2); print $2}')
    if [[ -n "$num" && "$num" != " " ]]; then
      a_num+=("$num")
      a_persona+=("$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/, "", $3); print $3}')")
      a_task+=("$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/, "", $4); print $4}')")
      a_files+=("$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/, "", $5); print $5}')")
      a_status+=("$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/, "", $6); print $6}')")
      a_started+=("$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/, "", $7); print $7}')")
      a_depends+=("$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/, "", $8); print $8}')")
      a_notes+=("$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/, "", $9); print $9}')")
      a_activity+=("$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/, "", $10); print $10}')")
      active_count=$((active_count + 1))
    fi
  fi
done < <(sed -n '/^## Active Sessions/,/^## [^A]/p' "$sf")

# Parse Completed Sessions table
completed_count=0
declare -a c_num=() c_persona=() c_task=() c_files=() c_duration=() c_completed=() c_outcome=()

while IFS= read -r line; do
  if [[ "$line" == "|"* && "$line" != *"---"* && "$line" != *"Persona"* ]]; then
    num=$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/, "", $2); print $2}')
    if [[ -n "$num" && "$num" != " " ]]; then
      c_num+=("$num")
      c_persona+=("$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/, "", $3); print $3}')")
      c_task+=("$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/, "", $4); print $4}')")
      c_files+=("$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/, "", $5); print $5}')")
      c_duration+=("$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/, "", $6); print $6}')")
      c_completed+=("$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/, "", $7); print $7}')")
      c_outcome+=("$(echo "$line" | awk -F'|' '{gsub(/^ +| +$/, "", $8); print $8}')")
      completed_count=$((completed_count + 1))
    fi
  fi
done < <(sed -n '/^## Completed Sessions/,/^## [^C]/p' "$sf")

# Parse Merge Order section (freeform lines)
merge_order=""
in_merge=0
while IFS= read -r line; do
  if [[ "$line" == *"## Merge Order"* ]]; then
    in_merge=1
    continue
  fi
  if [[ $in_merge -eq 1 && "$line" == "## "* ]]; then
    break
  fi
  if [[ $in_merge -eq 1 && -n "$line" ]]; then
    merge_order+="$line
"
  fi
done < "$sf"

# Parse Plan section (checklist items)
plan_items=""
in_plan=0
while IFS= read -r line; do
  if [[ "$line" == "## Plan" ]]; then
    in_plan=1
    continue
  fi
  if [[ $in_plan -eq 1 && "$line" == "## "* ]]; then
    break
  fi
  if [[ $in_plan -eq 1 && "$line" == "- ["* ]]; then
    plan_items+="$line
"
  fi
done < "$sf"

# --- Status helpers ---

# Map persona name to icon URL (GitHub raw)
persona_icon_url() {
  local name="$1"
  local base="https://raw.githubusercontent.com/code-katz/.github/main/media/logos"
  local lower
  lower=$(echo "$name" | tr '[:upper:]' '[:lower:]')
  case "$lower" in
    akira|alex|casey|jordan|kai|morgan|quinn|river|robin|sage|sasha|toni)
      echo "$base/${lower}-icon.png" ;;
    *) echo "" ;;
  esac
}

status_color() {
  case "$1" in
    planning)  echo "#6a9bcc" ;;
    coding)    echo "#d4a843" ;;
    reviewing) echo "#788c5d" ;;
    blocked)   echo "#c45c4e" ;;
    done)      echo "#7ab5b0" ;;
    merged)    echo "#8b7eb8" ;;
    abandoned) echo "#b0aea5" ;;
    *)         echo "#b0aea5" ;;
  esac
}

status_icon() {
  case "$1" in
    planning)  echo "&#x1F4CB;" ;;
    coding)    echo "&#x26A1;" ;;
    reviewing) echo "&#x1F50D;" ;;
    blocked)   echo "&#x1F6AB;" ;;
    done)      echo "&#x2705;" ;;
    merged)    echo "&#x1F3C1;" ;;
    abandoned) echo "&#x274C;" ;;
    *)         echo "&#x2753;" ;;
  esac
}

# --- HTML escape ---

html_escape() {
  local s="$1"
  s="${s//&/&amp;}"
  s="${s//</&lt;}"
  s="${s//>/&gt;}"
  s="${s//\"/&quot;}"
  echo "$s"
}

# --- Generate session cards HTML ---

session_cards_html=""
for (( i=0; i<active_count; i++ )); do
  local_status="${a_status[$i]}"
  badge_color=$(status_color "$local_status")
  icon=$(status_icon "$local_status")
  persona=$(html_escape "${a_persona[$i]}")
  task=$(html_escape "${a_task[$i]}")
  files=$(html_escape "${a_files[$i]}")
  started=$(html_escape "${a_started[$i]}")
  depends="${a_depends[$i]}"
  notes="${a_notes[$i]}"
  activity="${a_activity[$i]}"

  icon_url=$(persona_icon_url "${a_persona[$i]}")
  icon_img=""
  if [[ -n "$icon_url" ]]; then
    icon_img="<img class=\"persona-icon\" src=\"${icon_url}\" alt=\"${persona}\" />"
  fi

  deps_html=""
  if [[ -n "$depends" && "$depends" != "—" && "$depends" != "-" ]]; then
    deps_html="<div class=\"card-field\"><span class=\"field-label\">Depends on:</span> $(html_escape "$depends")</div>"
  fi

  activity_html=""
  if [[ -n "$activity" && "$activity" != " " ]]; then
    urgent_class=""
    if [[ "$activity" == *"needs response"* ]]; then
      urgent_class=" card-activity--urgent"
    fi
    activity_html="<div class=\"card-activity${urgent_class}\">$(html_escape "$activity")</div>"
  fi

  session_cards_html+="
    <div class=\"session-card\" data-started=\"${started}\">
      <div class=\"card-header\">
        ${icon_img}
        <span class=\"session-id\">#${a_num[$i]}</span>
        <span class=\"persona\">${persona}</span>
        <span class=\"status-badge\" style=\"background:${badge_color}\">${icon} ${local_status}</span>
      </div>
      ${activity_html}
      <div class=\"card-body\">
        <div class=\"card-task\">${task}</div>
        <div class=\"card-field\"><span class=\"field-label\">Files:</span> <code>${files}</code></div>
        <div class=\"card-field\"><span class=\"field-label\">Started:</span> ${started} <span class=\"card-elapsed\"></span></div>
        ${deps_html}
      </div>
    </div>"
done

# --- Generate merge order HTML ---

merge_html=""
if [[ -n "$merge_order" ]]; then
  while IFS= read -r line; do
    if [[ -n "$line" ]]; then
      merge_html+="<div class=\"merge-item\">$(html_escape "$line")</div>"
    fi
  done <<< "$merge_order"
fi

# --- Generate plan card HTML (Session 0) ---

plan_card_html=""
if [[ -n "$plan_items" ]]; then
  plan_checklist=""
  while IFS= read -r line; do
    if [[ -z "$line" ]]; then continue; fi
    if [[ "$line" == "- [x]"* ]]; then
      item_text="${line#- \[x\] }"
      plan_checklist+="<div class=\"plan-item checked\">&#x2705; <span class=\"plan-text-done\">${item_text}</span></div>"
    elif [[ "$line" == "- [ ]"* ]]; then
      item_text="${line#- \[ \] }"
      plan_checklist+="<div class=\"plan-item\">&#x2B1C; ${item_text}</div>"
    fi
  done <<< "$plan_items"

  # Count progress
  total_items=$(echo "$plan_items" | grep -c '^\- \[' || true)
  done_items=$(echo "$plan_items" | grep -c '^\- \[x\]' || true)

  plan_card_html="
    <div class=\"plan-card\">
      <div class=\"plan-header\">
        <span class=\"plan-title\">Coordinator</span>
        <span class=\"plan-progress\">${done_items}/${total_items} complete</span>
      </div>
      <div class=\"plan-body\">
        ${plan_checklist}
      </div>
    </div>"
fi

# --- Generate conflict warnings HTML ---

conflict_html=""
# Source the CLI to get detect_conflicts() and paths_overlap()
REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || readlink "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
CLI_PATH="$(cd "$(dirname "$REAL_SCRIPT")" && pwd)/claude-conductor"
if [[ -f "$CLI_PATH" ]]; then
  source "$CLI_PATH"
  conflicts=$(detect_conflicts "$sf" 2>/dev/null) || true
  if [[ -n "$conflicts" ]]; then
    conflict_items=""
    while IFS='|' read -r num_a persona_a num_b persona_b path; do
      conflict_items+="<div>&#x26A0; Sessions #${num_a} (${persona_a}) and #${num_b} (${persona_b}) both touch $(html_escape "$path")</div>"
    done <<< "$conflicts"
    conflict_html="
    <div class=\"conflict-banner\">
      <div class=\"conflict-title\">File Overlap Warnings</div>
      ${conflict_items}
    </div>"
  fi
fi

# --- Generate completed sessions HTML ---

completed_html=""
if (( completed_count > 0 )); then
  completed_html+="<table class=\"completed-table\">
    <thead><tr><th>#</th><th>Persona</th><th>Task</th><th>Files</th><th>Duration</th><th>Completed</th><th>Outcome</th></tr></thead>
    <tbody>"
  for (( i=0; i<completed_count; i++ )); do
    completed_html+="<tr>
      <td>${c_num[$i]}</td>
      <td>$(html_escape "${c_persona[$i]}")</td>
      <td>$(html_escape "${c_task[$i]}")</td>
      <td><code>$(html_escape "${c_files[$i]}")</code></td>
      <td>${c_duration[$i]}</td>
      <td>${c_completed[$i]}</td>
      <td>${c_outcome[$i]}</td>
    </tr>"
  done
  completed_html+="</tbody></table>"
fi

# --- Timestamp and version ---

now_ts=$(date "+%Y-%m-%d %H:%M:%S")
version_hash=$(date "+%s")

# --- Build main content ---

main_content=""

# Plan card (Session 0)
if [[ -n "$plan_card_html" ]]; then
  main_content+="    ${plan_card_html}
"
fi

# Conflict warnings
if [[ -n "$conflict_html" ]]; then
  main_content+="    ${conflict_html}
"
fi

# Active sessions section
if (( active_count > 0 )); then
  main_content+="    <h2 class=\"section-title\">Active Sessions</h2>
    <div class=\"card-grid\">
      ${session_cards_html}
    </div>
"
else
  main_content+="    <div class=\"no-sessions\">No active sessions. Start one with <code>claude-conductor start</code></div>
"
fi

# Merge order section
if [[ -n "$merge_html" ]]; then
  main_content+="    <h2 class=\"section-title\">Merge Order</h2>
    <div class=\"merge-section\">
      ${merge_html}
    </div>
"
fi

# Completed sessions section
if (( completed_count > 0 )); then
  main_content+="    <div class=\"completed-section\">
      <h2 class=\"section-title\">Completed Sessions</h2>
      ${completed_html}
    </div>
"
fi

# --- Write HTML from template ---

# Resolve symlinks to find the real script directory
REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || readlink "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_SCRIPT")" && pwd)"
template_file="$SCRIPT_DIR/../templates/dashboard.html"

if [[ ! -f "$template_file" ]]; then
  echo "Error: template not found at $template_file" >&2
  exit 1
fi

template=$(<"$template_file")

# Pluralize "session"
active_label="session"
if [[ "$active_count" != "1" ]]; then
  active_label="sessions"
fi

# Substitute simple placeholders (no special chars)
template="${template//\{\{VERSION_HASH\}\}/$version_hash}"
template="${template//\{\{PROJECT_NAME\}\}/$project_name}"
template="${template//\{\{ACTIVE_COUNT\}\}/$active_count}"
template="${template//\{\{ACTIVE_SESSIONS_LABEL\}\}/$active_label}"
template="${template//\{\{NOW_TS\}\}/$now_ts}"

# Split template at {{MAIN_CONTENT}} and concatenate with content
# (avoids bash substitution mangling HTML entities like &#x1F4CB;)
before_main="${template%%\{\{MAIN_CONTENT\}\}*}"
after_main="${template#*\{\{MAIN_CONTENT\}\}}"
printf '%s%s%s\n' "$before_main" "$main_content" "$after_main" > "$dashboard_file"

echo "$dashboard_file"
